rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function validName(s) { return s is string && s.size() >= 2 && s.size() <= 60; }
    function validData(d) {
      return d.keys().hasOnly(['firstName', 'lastName', 'name', 'phone', 'email', 'tutorialDone', 'createdAt'])
        && validName(d.firstName) && validName(d.lastName)
        && d.phone is string && d.phone.matches('^[+][0-9]{9,15}$');
    }
    function complete(d) {
      return d.get('firstName', '') != '' && d.get('lastName', '') != '' && d.get('phone', '') != '';
    }

    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    // Administrador = existe el documento admins/{tu correo}. Solo se crea desde la consola de Firebase.
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(myEmail())); }

    // Prueba gratis (1 día): el propio usuario puede crear SU documento allowed/{correo} UNA sola vez,
    // solo como prueba, y solo junto con las marcas de su dispositivo y de su celular (batch atómico).
    // Si el dispositivo o el celular ya usaron la prueba, la marca ya existe y la operación completa falla.
    function trialOk(email) {
      let d = request.resource.data;
      return signedIn() && myEmail() == email
        && d.keys().hasOnly(['plan', 'trial', 'deviceId', 'phone', 'createdAt'])
        && d.plan == 'prueba' && d.trial == true
        && d.createdAt == request.time
        && d.deviceId is string && d.deviceId.size() >= 8 && d.deviceId.size() <= 64
        && d.phone is string && d.phone.matches('^[+][0-9]{9,15}$')
        && existsAfter(/databases/$(database)/documents/trialClaims/$('d_' + d.deviceId))
        && existsAfter(/databases/$(database)/documents/trialClaims/$('p_' + d.phone));
    }

    match /admins/{email} {
      allow get: if signedIn() && myEmail() == email;
      allow list, write: if false;
    }

    // Lista de acceso: cada cliente puede LEER su propio documento; solo el administrador la escribe
    // (renovaciones desde el panel de la app). Documento = correo en minúsculas.
    //   until (timestamp) = vencimiento · trial = true y sin until → prueba: createdAt + 1 día.
    match /allowed/{email} {
      allow get: if signedIn() && myEmail() == email;
      allow read, write: if isAdmin();
      allow create: if trialOk(email);
    }

    // Marcas anti-abuso de la prueba gratis (una por dispositivo y una por celular). No se pueden editar ni borrar desde la app.
    match /trialClaims/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['email', 'createdAt'])
        && request.resource.data.email == myEmail()
        && request.resource.data.createdAt == request.time
        && (id.matches('^d_.{8,64}$') || id.matches('^p_[+][0-9]{9,15}$'))
        && existsAfter(/databases/$(database)/documents/allowed/$(myEmail()));
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid && validData(request.resource.data);
      // Nombres y teléfono se pueden escribir UNA vez (mientras el perfil está incompleto).
      // Después solo se permite marcar el tutorial como visto. Cambios de datos: por WhatsApp (consola de Firebase).
      allow update: if request.auth != null && request.auth.uid == uid && (
          (!complete(resource.data) && validData(request.resource.data))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tutorialDone'])
              && request.resource.data.tutorialDone == true));
      allow delete: if false;
    }
  }
}
