rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function validName(s) { return s is string && s.size() >= 2 && s.size() <= 60; }
    function validData(d) {
      return d.keys().hasOnly(['firstName', 'lastName', 'name', 'phone', 'email', 'tutorialDone', 'createdAt'])
        && validName(d.firstName) && validName(d.lastName)
        && d.phone is string && d.phone.matches('^[+][0-9]{9,15}$');
    }
    function complete(d) {
      return d.get('firstName', '') != '' && d.get('lastName', '') != '' && d.get('phone', '') != '';
    }

    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    // Administrador = existe el documento admins/{tu correo}. Solo se crea desde la consola de Firebase.
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(myEmail())); }

    match /admins/{email} {
      allow get: if signedIn() && myEmail() == email;
      allow list, write: if false;
    }

    // Lista de acceso (pago único, de por vida): cada cliente puede LEER su propio documento; solo el administrador
    // lo crea/edita (botón "Verificar y activar" del panel). Documento = correo en minúsculas. Sin documento = sin acceso.
    match /allowed/{email} {
      allow get: if signedIn() && myEmail() == email;
      allow read, write: if isAdmin();
    }

    // Solicitudes de acceso: al registrarse, cada cuenta crea requests/{correo} con status = pending. El administrador la ve
    // (y recibe la notificación «Tienes un correo pendiente por activar») y la activa o la rechaza (status = approved / rejected).
    match /requests/{email} {
      allow get: if signedIn() && myEmail() == email;
      allow read, write: if isAdmin();
      allow create: if signedIn() && myEmail() == email
        && request.resource.data.keys().hasOnly(['email', 'uid', 'name', 'phone', 'status', 'createdAt'])
        && request.resource.data.email == email && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
        && request.resource.data.createdAt == request.time;
    }

    // Sesión única: sessions/{uid} guarda el identificador de la sesión activa. Cada vez que alguien inicia sesión en un
    // teléfono escribe uno nuevo; los demás teléfonos de esa cuenta lo detectan y se cierran solos.
    match /sessions/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['sid', 'device', 'updatedAt'])
        && request.resource.data.sid is string && request.resource.data.sid.size() >= 8 && request.resource.data.sid.size() <= 64
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // Ranking mensual: monthly/{año-mes}_{uid}. Cada cliente solo puede SUMAR pedidos a su propio documento
    // (de pocos en pocos); el administrador lee todos para armar el top del mes.
    match /monthly/{id} {
      allow read: if signedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.month + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['month', 'uid', 'email', 'name', 'orders', 'updatedAt'])
        && request.resource.data.month is string && request.resource.data.month.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.email == myEmail()
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.orders is int && request.resource.data.orders >= 1 && request.resource.data.orders <= 20
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid && request.resource.data.month == resource.data.month
        && request.resource.data.keys().hasOnly(['month', 'uid', 'email', 'name', 'orders', 'updatedAt'])
        && request.resource.data.email == myEmail()
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.orders is int && request.resource.data.orders > resource.data.orders
        && request.resource.data.orders - resource.data.orders <= 20
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // Encuestas Sí/No del administrador: todos las leen; solo el administrador las crea, cierra o borra.
    // Cada cuenta vota UNA vez (polls/{id}/votes/{uid}), solo con la encuesta abierta; el voto no se puede cambiar.
    match /polls/{pollId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['title', 'description', 'closed', 'createdAt', 'by'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
        && request.resource.data.description is string && request.resource.data.description.size() <= 500
        && request.resource.data.closed == false
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['closed']);
      allow delete: if isAdmin();

      match /votes/{uid} {
        allow read: if signedIn() && (isAdmin() || request.auth.uid == uid);
        allow create: if signedIn() && request.auth.uid == uid
          && get(/databases/$(database)/documents/polls/$(pollId)).data.closed == false
          && request.resource.data.keys().hasOnly(['vote', 'email', 'name', 'votedAt'])
          && request.resource.data.vote in ['yes', 'no']
          && request.resource.data.email == myEmail()
          && request.resource.data.name is string && request.resource.data.name.size() <= 80
          && request.resource.data.votedAt == request.time;
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // Avisos del administrador: todos los usuarios con sesión los leen; solo el administrador los crea.
    match /announcements/{id} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['title', 'message', 'createdAt', 'by'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid && validData(request.resource.data);
      // Nombres y teléfono se pueden escribir UNA vez (mientras el perfil está incompleto).
      // Después solo se permite marcar el tutorial como visto. Cambios de datos: por WhatsApp (consola de Firebase).
      allow update: if request.auth != null && request.auth.uid == uid && (
          (!complete(resource.data) && validData(request.resource.data))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tutorialDone'])
              && request.resource.data.tutorialDone == true));
      allow delete: if false;
    }
  }
}
